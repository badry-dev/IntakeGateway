
# App
APP_NAME=intake-gateway
APP_DATABASE_URL=sqlite:///./intakegateway_app.db
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Riyadh

# Destination database fallback
# App state is stored locally in APP_DATABASE_URL. These Oracle settings are
# only used when no saved destination connection is active.
ORACLE_USER=your_user
ORACLE_PASSWORD=your_password
ORACLE_HOST=your_host
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCLPDB1

# Optional: EZCONNECT, overrides the above when set
# ORACLE_DSN=host:1521/service_name

# Redis / Celery (Redis requires a password and is not published to the host)
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Shared API token for management endpoints (required in production; the API
# refuses to start without it when APP_ENV=production). Authenticates the API
# but provides no per-user authorization.
API_TOKEN=

# Comma-separated hosts allowed to resolve to private/loopback/link-local
# addresses (SSRF escape hatch for legitimate internal sources). Default: empty.
ALLOWED_SOURCE_HOSTS=

# HTTP defaults
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RESPONSE_MB=10

# Encrypted destination connections
ENCRYPTION_KEY=replace_with_base64_fernet_key
CONNECTIONS_FILE_PATH=connections.enc
FRONTEND_URL=http://localhost:5173
