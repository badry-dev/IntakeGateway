
# App
APP_NAME=intake-gateway
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Riyadh

# Oracle (SQLAlchemy & python-oracledb)
ORACLE_USER=your_user
ORACLE_PASSWORD=your_password
ORACLE_HOST=your_host
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCLPDB1

# Optional: EZCONNECT, overrides the above when set
# ORACLE_DSN=host:1521/service_name

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# HTTP defaults
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RESPONSE_MB=10

# Crypto (for secret encryption at rest; dev-only default)
SECRET_KEY=dev-secret-change-me
