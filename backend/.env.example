# Application Settings
APP_NAME=intake-gateway
APP_DATABASE_URL=sqlite:///./intakegateway_app.db
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Riyadh

# Destination Database Fallback
# App state is stored locally in APP_DATABASE_URL.
# These Oracle settings are only used for ingestion when no saved connection
# is active.
ORACLE_USER=your_oracle_username
ORACLE_PASSWORD=your_oracle_password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1

# Alternative: Use ORACLE_DSN instead of HOST/PORT/SERVICE_NAME
# ORACLE_DSN=localhost:1521/XEPDB1

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# HTTP Settings
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RESPONSE_MB=10

# Encrypted destination connections
ENCRYPTION_KEY=replace_with_base64_fernet_key
CONNECTIONS_FILE_PATH=connections.enc

# Frontend
FRONTEND_URL=http://localhost:5173
